# ========================================================
# WHATSAPP FINANCE BOT - ENVIRONMENT CONFIGURATION
# ========================================================

# 1. Google Gemini API Key (Dapatkan gratis di https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# 2. Google Spreadsheet ID (Diambil dari URL Google Sheet Anda)
# Contoh URL: https://docs.google.com/spreadsheets/d/1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgvE2upms/edit
SPREADSHEET_ID=your_spreadsheet_id_here

# 3. Path ke Google Service Account Key JSON (Untuk Lokal) atau String JSON (Untuk Cloud)
GOOGLE_APPLICATION_CREDENTIALS=credentials/google-service-account.json
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# 4. Filter Nomor WhatsApp yang Diizinkan (Opsional tapi direkomendasikan untuk keamanan)
# Masukkan nomor HP berformat internasional tanpa tanda + atau spasi, pisahkan dengan koma jika lebih dari 1.
# Contoh: 6281234567890,6289876543210
ALLOWED_NUMBERS=6281234567890

# 5. Nama Bot / Prefix Command (Default: "!")
BOT_NAME="FinanceBot"
COMMAND_PREFIX="!"
PORT=8000
